# Copy this file to .env and fill in your real values.
# Never commit the actual .env file.

# Local Postgres example:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/scholario"
# Neon (production) example:
# DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/scholario?sslmode=require"
DATABASE_URL=

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (Gmail API via OAuth2) - used for verification codes and password
# reset codes. Sends through the Gmail API (HTTPS), not SMTP, so it works
# even on hosts that block outbound SMTP ports.
GMAIL_USER=youraddress@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
